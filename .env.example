# ==========================================
# LunaTV 环境变量配置示例
# 复制此文件为 .env：cp .env.example .env
# ==========================================

# 1. 站长后台管理账号密码（必填，请务必设置强密码）
USERNAME=admin
PASSWORD=ChangeMe_StrongPassword123!

# 2. 绑定的域名与访问地址
# 请填写你的自定义域名（例如 tv.example.com），不要带 http:// 或 /
DOMAIN=tv.yourdomain.com
# 站点基础 URL（供页面生成绝对路径）
SITE_BASE=https://tv.yourdomain.com

# 3. 站点显示配置
SITE_NAME=LunaTV
ANNOUNCEMENT=欢迎使用 LunaTV！本站仅供个人学习交流使用。

# 4. 宿主机访问端口（默认 3000）
PORT=3000

# 5. 豆瓣 API 与封面图片代理（推荐腾讯 CDN 加速）
DOUBAN_PROXY_TYPE=cmliussss-cdn-tencent
DOUBAN_IMAGE_PROXY_TYPE=cmliussss-cdn-tencent

# 6. 搜索最大翻页限制
SEARCH_MAX_PAGE=5
